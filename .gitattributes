# Normalize all text files to LF in the repository and in the working tree.
# Motherboard is deployed on Linux (Apache/Docker), so LF is the native form
# everywhere it runs. Git detects text vs binary automatically.
* text=auto eol=lf

# Explicitly binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
