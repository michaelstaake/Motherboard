# Motherboard production settings.
#
#   cp .env.example .env    then edit    then chmod 600 .env
#
# Read automatically by `docker compose -f docker-compose.prod.yml ...`.
# Never commit .env — it holds your database and SMTP passwords.

# --- Where the app is reachable -------------------------------------------
# The LAN address of this box and the port you publish on. BASE_URL must match
# exactly what staff type in the browser: the app builds links and its HTTPS
# redirect from BASE_URL, not from the Host header.
BASE_URL=http://192.168.1.50:8080
WEB_PORT=8080
# 0.0.0.0 = reachable from the LAN. Use 127.0.0.1 to keep it on this box only
# (useful while you complete the installer, or behind a reverse proxy).
WEB_BIND=0.0.0.0

# Set to true ONLY when the app is served over HTTPS — typically when a reverse
# proxy terminates TLS in front of it. The app does not read X-Forwarded-Proto
# when deciding to mark the session cookie Secure, so behind a TLS proxy this
# must be true or the cookie ships without the Secure flag.
FORCE_HTTPS=false

# PHP timezone. Affects every displayed date. Use a tz database name.
APP_TIMEZONE=America/Los_Angeles

# --- Secrets ---------------------------------------------------------------
# Encrypts customer device passwords. Generate ONE value, before first start:
#   docker run --rm php:8.4-cli php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# Back it up with your database. Changing it after data exists makes every
# stored device password permanently unreadable. Must be 32+ characters.
APP_ENCRYPTION_KEY=

# Database. DB_PASS is applied when the data volume is first created; changing
# it later here does NOT change the password inside MySQL.
DB_NAME=motherboard
DB_USER=motherboard
DB_PASS=
DB_ROOT_PASS=

# --- Email -----------------------------------------------------------------
# Leave SMTP_HOST empty until you have real credentials; the app only fails
# when it actually tries to send. SMTP_SECURE is tls, ssl, or empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@yourshop.example

# --- phpMyAdmin ------------------------------------------------------------
# Published to the LAN by default, behind its own login form (use DB_USER /
# DB_PASS, or root / DB_ROOT_PASS). Set PMA_BIND=127.0.0.1 to restrict it to
# this box, or start with --scale phpmyadmin=0 to not run it at all.
PMA_PORT=8081
PMA_BIND=0.0.0.0

# --- Optional --------------------------------------------------------------
# Uncomment so plain `docker compose ...` uses the production file:
# COMPOSE_FILE=docker-compose.prod.yml
