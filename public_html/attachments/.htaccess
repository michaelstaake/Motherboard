Require all denied

# Belt and braces: even if the deny above is bypassed by a permissive vhost,
# nothing in this tree should ever be handed to an interpreter.
# php_flag only applies when mod_php is loaded (it is a no-op under PHP-FPM),
# so the handler removal below is what covers the common FPM setup.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar

<FilesMatch "\.(php|php[3-8]|phtml|phar|pht|inc)$">
    SetHandler none
    Require all denied
</FilesMatch>
